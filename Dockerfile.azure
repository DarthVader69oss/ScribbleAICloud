FROM python:3.12-slim

WORKDIR /app
COPY lambda/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir "torch==2.5.1+cpu" --extra-index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r /app/requirements.txt "fastapi>=0.115,<1" "uvicorn>=0.30,<1"

COPY ml/src /app/ml/src
COPY lambda/handler.py /app/lambda/handler.py
COPY scripts/local_server.py /app/scripts/local_server.py
COPY ui/ /app/ui/
COPY build/models/finetuned/ /app/models/finetuned/

ENV PYTHONUNBUFFERED=1 MODEL_IDS=finetuned DEFAULT_MODEL=finetuned AWS_EXECUTION_ENV=azure-container-apps
EXPOSE 8000
CMD ["python", "scripts/local_server.py", "--models", "/app/models", "--host", "0.0.0.0", "--port", "8000"]
