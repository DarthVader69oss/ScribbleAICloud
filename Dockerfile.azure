FROM python:3.12-slim

WORKDIR /app
COPY azure/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir "torch==2.5.1+cpu" --extra-index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r /app/requirements.txt "fastapi>=0.115,<1" "uvicorn>=0.30,<1"

COPY ml/src /app/ml/src
COPY demo/app.py /app/demo/app.py
COPY demo/static/ /app/demo/static/
COPY build/models/finetuned/ /app/models/finetuned/

ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["python", "demo/app.py", "--ckpt", "/app/models/finetuned/model.pt", "--no-gradio", "--host", "0.0.0.0", "--port", "8000"]
